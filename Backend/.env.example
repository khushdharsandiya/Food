JWT_SECRET="change_me"
MONGO_URI="mongodb+srv://username:password@cluster0.example.mongodb.net/Foodie_frenzy?retryWrites=true&w=majority"
MONGO_URI_FALLBACK="mongodb://localhost:27017/Foodie_frenzy"

NODE_ENV="production"
STRIPE_SECRET_KEY="sk_test_or_sk_live_here"
FRONTEND_URL="https://your-frontend.vercel.app"

RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

ORDER_RETENTION_HOURS=168
ORDER_AUTO_DELIVER_AFTER_OUT_MS=300000

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_me"

# ---------- OTP / mail (production on Render) ----------
# For Gmail SMTP: leave BREVO_API_KEY and RESEND_API_KEY unset (empty), or mail goes through those APIs first.
MAIL_LOG_RESET_LINK_TO_CONSOLE=false
MAIL_LOG_OTP_TO_CONSOLE=false
MAIL_OTP_CONSOLE_ONLY=false

# Gmail login = full account email (not "mail" or a nickname)
EMAIL_USER="you@gmail.com"
# 16-character App Password only (no spaces). Never your normal Gmail password.
EMAIL_PASS="abcdabcdabcdabcd"

# From header (should match the mailbox you send from)
MAIL_FROM="Foodie Frenzy <you@gmail.com>"

# Gmail on Render: code forces port 465 + secure:true when SMTP_HOST is smtp.gmail.com
# (unless GMAIL_ALLOW_STARTTLS=true, then 587 + STARTTLS from SMTP_PORT/SMTP_SECURE)
SMTP_HOST="smtp.gmail.com"
SMTP_VERIFY_BEFORE_SEND=true
# Optional timeouts (ms)
# SMTP_CONNECTION_TIMEOUT_MS=20000
# SMTP_GREETING_TIMEOUT_MS=20000
# SMTP_SOCKET_TIMEOUT_MS=25000

# Optional: prefer STARTTLS on 587 instead of implicit TLS on 465
# GMAIL_ALLOW_STARTTLS=false

# ---------- More reliable on Render than Gmail SMTP (optional) ----------
# If set, OTP uses Brevo HTTPS API instead of SMTP (avoids ETIMEDOUT / firewall issues).
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

RESEND_API_KEY=""
RESEND_FROM="Foodie Frenzy <onboarding@resend.dev>"

# ---------- Legacy aliases (optional; prefer EMAIL_USER / EMAIL_PASS) ----------
# SMTP_USER=""
# SMTP_PASS=""
