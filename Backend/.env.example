# ---------- OTP / mail — Brevo SMTP (production on Render; no Gmail required) ----------
# Brevo dashboard: SMTP & API → SMTP → copy "Login" and "SMTP key" (password), not your Brevo login password.
# Where to paste on Render: BREVO_SMTP_LOGIN = Login column | BREVO_SMTP_KEY = SMTP key (masked; use "Generate" if needed).
MAIL_LOG_RESET_LINK_TO_CONSOLE=false
MAIL_LOG_OTP_TO_CONSOLE=false
MAIL_OTP_CONSOLE_ONLY=false

BREVO_SMTP_LOGIN="your_login_from_brevo_smtp_page"
BREVO_SMTP_KEY="your_smtp_key_from_brevo"

# Sender shown to recipients — must be verified in Brevo (Senders / your domain).
MAIL_FROM="Foodie Frenzy <noreply@your-verified-domain.com>"

SMTP_HOST="smtp-relay.brevo.com"
# Defaults in code: 465 + TLS for Brevo. Override if your network prefers STARTTLS on 587:
# SMTP_PORT=587
# SMTP_SECURE=false

SMTP_VERIFY_BEFORE_SEND=true
# Optional longer timeouts on Render (ms)
# SMTP_CONNECTION_TIMEOUT_MS=25000
# SMTP_GREETING_TIMEOUT_MS=25000
# SMTP_SOCKET_TIMEOUT_MS=30000
# SMTP_POOL=false

# Use Brevo HTTPS API instead of SMTP (optional). If you only want SMTP, leave empty or unset.
# If both BREVO_API_KEY and BREVO_SMTP_* are set, SMTP is used first unless BREVO_FORCE_HTTP_API=true.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
# BREVO_FORCE_HTTP_API=false

RESEND_API_KEY=""
RESEND_FROM="Foodie Frenzy <onboarding@resend.dev>"

# ---------- Legacy Gmail (only if you still use Gmail SMTP) ----------
# SMTP_HOST="smtp.gmail.com"
# EMAIL_USER="you@gmail.com"
# EMAIL_PASS="16_char_app_password"
# GMAIL_ALLOW_STARTTLS=false
